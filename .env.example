# Copy to `.env` (which is gitignored) and fill in real values.
# Shell environment overrides anything set here:
#   INFLUX_TOKEN=... ./trading_bot

# ── Delta Exchange (India) ────────────────────────────────────────────────────
# Prod hosts are the defaults; uncomment the testnet block to switch.
DELTA_REST_HOST=api.india.delta.exchange
DELTA_WS_PUBLIC_HOST=public-socket.india.delta.exchange
DELTA_WS_PRIVATE_HOST=socket.india.delta.exchange

DELTA_API_KEY=
DELTA_API_SECRET=

# Testnet (uncomment to use, comment out the prod lines above):
# DELTA_REST_HOST=cdn-ind.testnet.deltaex.org
# DELTA_WS_PUBLIC_HOST=socket-ind-pub.testnet.deltaex.org
# DELTA_WS_PRIVATE_HOST=socket-ind.testnet.deltaex.org
# DELTA_API_KEY=JiV80pv3OJKlUyisMN2x4BHqnKONW5
# DELTA_API_SECRET=ELUujrDwVJrK5UiJBkQyBKTJNdVvOOy8OKUuEsjxaeeLWXai6emZYsCFtt40

# ── InfluxDB v2 (local docker-compose) ────────────────────────────────────────
INFLUX_HOST=127.0.0.1
INFLUX_PORT=8086
INFLUX_ORG=trading
INFLUX_BUCKET=latency
INFLUX_TOKEN=
